#!/bin/bash
# Open openside in the patched browser: a dedicated user profile (not the daemon's
# agent profile, not any other browser profile) with the openside extension loaded
# and the new-tab page pointing at the daemon web UI.
#
#   openside-browser          open the local-person web UI
#   openside-browser --pair   reopen with current local authority (e.g. after signing out)
#   openside-browser URL...   extra arguments are passed to the browser
#
# OPENSIDE_BROWSER_THEME=light|dark|off picks the tab-strip theme (default: follow the desktop colour scheme).
# OPENSIDE_BROWSER_LANG=ko|en|… picks the browser UI language, overriding browser.language in
# config.toml (default: the OS locale).
set -euo pipefail

config=${XDG_CONFIG_HOME:-$HOME/.config}/openside/config.toml
data=${XDG_DATA_HOME:-$HOME/.local/share}/openside
# <data>/browser-profile belongs to the daemon's agent browser; keep the user's apart.
profile=$data/user-browser-profile
extension=$data/extension
# Pinned by the manifest key (web/src/desktopNotifyProtocol.ts EXTENSION_ID).
extension_id=jneddlbpgmlheplolfonafkbkbkjhcfj
# Launchers may not have ~/.local/bin on PATH; use the CLI installed beside this script.
cli=${BASH_SOURCE[0]%/*}/openside

fail() {
  echo "openside-browser: $*" >&2
  command -v notify-send >/dev/null && notify-send -a openside "openside" "$*" || true
  exit 1
}

# The same values the daemon reads; this script only needs these two keys.
toml_value() {
  sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$config" | head -n1
}

# A key within one [section]; for names that other sections also use.
section_value() {
  awk -v section="[$1]" -v key="$2" '
    /^[[:space:]]*\[/ { current = $0; sub(/#.*/, "", current); gsub(/[[:space:]]/, "", current); next }
    current == section && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
      if (match($0, /"[^"]*"|'\''[^'\'']*'\''/)) { print substr($0, RSTART + 1, RLENGTH - 2); exit }
    }' "$config"
}

# Test switches open test-only gateway methods that drive the browser's UI; they are for the
# patched-browser tests, never for a person's browser, so they are dropped from what is forwarded.
forwarded=()
for argument in "$@"; do
  if [[ $argument == --openside-test-* ]]; then
    echo "openside-browser: ignoring the test-only switch $argument" >&2
  else
    forwarded+=("$argument")
  fi
done
set -- "${forwarded[@]}"

[[ -r $config ]] || fail "missing $config"
browser=$(toml_value executable)
listen=$(toml_value listen)
[[ -x $browser ]] || fail "browser.executable is not set to an executable in $config"
[[ -n $listen ]] || fail "daemon.listen is not set in $config"
ui=http://$listen/

if ! curl -fsS -o /dev/null --max-time 2 "$ui"; then
  systemctl --user start openside.service || true
  for _ in {1..20}; do
    curl -fsS -o /dev/null --max-time 1 "$ui" && break
    sleep 0.25
  done
  curl -fsS -o /dev/null --max-time 2 "$ui" || fail "daemon web UI is not reachable at $ui (journalctl --user -u openside)"
fi

if [[ ${1:-} == --pair ]]; then
  shift
fi

# A fresh owner bootstrap upgrades legacy browser sign-ins without trusting display names as provenance.
legacy=$("$cli" --json device list | jq -sr \
  '.[0].devices[] | select(.name == "openside-browser" and (.scopes | index("admin") | not)) | .device_id')
# The socket proves local possession; the per-boot secret is handed off only in a fragment.
# Never use a QR offer for this profile: QR redemption deliberately lacks local authority.
access=$("$cli" --json remote local-access) || fail "could not bootstrap local browser access"
open=$(jq -ser '.[0].url // empty' <<<"$access") || fail "daemon has no loopback launch URL"
[[ -n $open ]] || fail "daemon has no loopback launch URL"
if [[ -n $legacy ]]; then
  echo "openside-browser: local owner sign-in now includes admin permissions" >&2
fi

# The patched build turns vertical tabs on by default, which puts a second left column next to the
# web UI's own conversation sidebar. Start this profile with horizontal tabs. Saved tab groups are
# also kept out of the bookmarks bar: the extension's Agent Tabs group would otherwise appear twice,
# once in the tab strip and once as a pinned chip. A key that already exists (the user changed it in
# the browser) is never overwritten.
#
# Ctrl+E (⌘E) toggles the extension's side panel. Chromium will not hand an extension a shortcut it
# uses itself (Ctrl+E focuses search), but a binding in the profile, as if set in
# chrome://extensions/shortcuts, takes precedence. Ctrl+Shift+A (⇧⌘A) is bound the same way to the
# extension's search palette command: Chromium uses it for tab search, and on the openside tab the
# page itself handles it first. Each shortcut is seeded once per profile, under its own marker, so
# profiles seeded before the palette existed still get it, and a shortcut the person later changes
# or removes stays that way. A key the person already gave to something else is left to them.
#
# A running browser rewrites Preferences from memory, so a profile a browser may own is left alone
# and picks this up on a later launch. Any lock counts (live, stale or another host's), it is checked
# again right before the new file replaces the old, and one seeder runs at a time.
profile_in_use() {
  [[ -L $profile/SingletonLock || -e $profile/SingletonLock || -L $profile/SingletonSocket || -e $profile/SingletonSocket ]]
}
seed_profile_defaults() {
  local lock=$profile/.openside-seed.lock status=0
  profile_in_use && return 0
  mkdir -p "$profile/Default"
  # A seeder that died leaves its lock behind; one older than two minutes is not held by anyone.
  find "$lock" -maxdepth 0 -type d -mmin +2 -exec rmdir {} \; 2>/dev/null || true
  mkdir "$lock" 2>/dev/null || return 0
  seed_preferences || status=$?
  rmdir "$lock"
  return "$status"
}
seed_preferences() {
  local prefs=$profile/Default/Preferences tmp panel=true palette=true
  local panel_key=linux:Ctrl+E palette_key=linux:Ctrl+Shift+A
  [[ -e $profile/.openside-panel-shortcut ]] && panel=false
  [[ -e $profile/.openside-palette-shortcut ]] && palette=false
  if [[ $(uname -s) == Darwin ]]; then
    panel_key=mac:Command+E
    palette_key=mac:Command+Shift+A
  fi
  tmp=$(umask 077; mktemp "$profile/Default/.Preferences.XXXXXX") || return 1
  # The result must be a JSON object in which every shortcut being seeded holds its key before it
  # replaces anything; only then are the shortcuts marked as seeded.
  local shortcuts='
      def bound($command): [.extensions.commands // {} | .[] | select(.extension == $extension and .command_name == $command)] | length > 0;
      def held($key; $command): bound($command) or (.extensions.commands // {} | has($key));'
  if ! { if [[ -s $prefs ]]; then cat "$prefs"; else printf '{}\n'; fi; } \
    | jq -c --argjson panel "$panel" --argjson palette "$palette" --arg panel_key "$panel_key" \
      --arg palette_key "$palette_key" --arg extension "$extension_id" "$shortcuts"'
      def seed($path; $value): if getpath($path) == null then setpath($path; $value) else . end;
      def bind($on; $key; $command):
        if $on and (bound($command) | not)
        then seed(["extensions", "commands", $key]; {extension: $extension, command_name: $command, global: false})
        else . end;
      seed(["vertical_tabs", "enabled"]; false)
      | seed(["auto_pin_new_tab_groups"]; false)
      | seed(["bookmark_bar", "show_tab_groups"]; false)
      | bind($panel; $panel_key; "_execute_action")
      | bind($palette; $palette_key; "open-palette")' >"$tmp" \
    || ! jq -e --argjson panel "$panel" --argjson palette "$palette" --arg panel_key "$panel_key" \
      --arg palette_key "$palette_key" --arg extension "$extension_id" "$shortcuts"'
      type == "object"
      and (($panel | not) or held($panel_key; "_execute_action"))
      and (($palette | not) or held($palette_key; "open-palette"))' "$tmp" >/dev/null; then
    rm -f "$tmp"
    return 1
  fi
  if profile_in_use; then
    rm -f "$tmp"
    return 0
  fi
  mv -f "$tmp" "$prefs" || { rm -f "$tmp"; return 1; }
  : >"$profile/.openside-panel-shortcut"
  : >"$profile/.openside-palette-shortcut"
}

# Tab strip colours cannot be themed from an extension page and the browser has no setting for them,
# so a tiny unpacked theme paints the web UI's backdrop gradient behind the tab strip. The scheme
# follows the desktop (OPENSIDE_BROWSER_THEME=light|dark|off overrides it). The gradient is a 1x1440
# PNG: Chromium neither stretches nor tiles a frame image vertically, so the frame colour is its
# bottom colour and anything taller than the image continues seamlessly.
write_theme() {
  local scheme=${OPENSIDE_BROWSER_THEME:-auto} dir name image colors
  if [[ $scheme == auto ]]; then
    scheme=light
    [[ $(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null) == *dark* ]] && scheme=dark
  fi
  case $scheme in
    off) return 0 ;;
    dark)
      name="openside evening"
      
      colors='{"frame":[155,127,152],"frame_inactive":[90,98,150],"toolbar":[29,29,31],"tab_text":[245,245,247],"tab_background_text":[245,245,247],"bookmark_text":[245,245,247],"toolbar_button_icon":[245,245,247],"omnibox_background":[48,48,54],"omnibox_text":[245,245,247],"button_background":[29,29,31,0.5],"background_tab":[29,29,31,0.3]}'
      ;;
    light)
      name="openside sky"
      
      colors='{"frame":[246,226,214],"frame_inactive":[236,226,232],"toolbar":[246,249,253],"tab_text":[29,29,31],"tab_background_text":[29,29,31],"bookmark_text":[29,29,31],"toolbar_button_icon":[29,29,31],"omnibox_background":[226,235,247],"omnibox_text":[29,29,31],"button_background":[255,255,255,0.5],"background_tab":[255,255,255,0.3]}'
      ;;
    *) return 0 ;;
  esac
  dir=$data/browser-theme-$scheme
  mkdir -p "$dir"
  base64 -d <<<"$image" >"$dir/frame.png"
  jq -n --arg name "$name" --argjson colors "$colors" \
    '{manifest_version: 3, name: $name, version: "1.0", theme: {images: {theme_frame: "frame.png"}, colors: $colors, properties: {frame_tiling: "repeat-x"}}}' >"$dir/manifest.json"
  theme=$dir
}

mkdir -p "$profile"
chmod 700 "$profile"
seed_profile_defaults || echo "openside-browser: could not seed profile defaults; leaving the profile as is" >&2
theme=
write_theme || echo "openside-browser: could not write the browser theme; continuing without it" >&2

# Credentials must not appear in process argv, even when an existing browser opens the tab.
runtime_mode=
if [[ -n ${XDG_RUNTIME_DIR:-} && -d $XDG_RUNTIME_DIR && -O $XDG_RUNTIME_DIR ]]; then
  runtime_mode=$(stat -c %a "$XDG_RUNTIME_DIR" 2>/dev/null || stat -f %Lp "$XDG_RUNTIME_DIR" 2>/dev/null || true)
fi
if [[ $runtime_mode == 700 ]]; then
  handoff_dir=$(umask 077; mktemp -d "$XDG_RUNTIME_DIR/openside-browser.XXXXXX")
else
  handoff_dir=$(umask 077; mktemp -d "${TMPDIR:-/tmp}/openside-browser.XXXXXX")
fi
chmod 700 "$handoff_dir"
handoff=$handoff_dir/launch.html
escaped=$(jq -sr '.[0].url | @html' <<<"$access")
(umask 077; printf '<!doctype html><meta http-equiv="refresh" content="0;url=%s">\n' "$escaped" >"$handoff")

# The extension trusts one daemon origin, named in its manifest (host_permissions and
# externally_connectable): this daemon's resolved loopback listener, taken from its launch URL.
daemon_origin=
if [[ $open =~ ^(http://(127\.0\.0\.1|localhost|\[::1\]):[0-9]+)/ ]]; then
  daemon_origin=${BASH_REMATCH[1]}
fi

# Files for the extension go into its real directory (installs link data/extension to a release),
# and only when this user alone can write there: owned by us, not writable by group or others.
# Same-user processes are trusted anyway; this keeps a shared or misconfigured directory out.
extension_dir=
if real=$(cd -P -- "$extension" 2>/dev/null && pwd -P) && [[ -d $real && -O $real ]] \
  && mode=$(stat -c %a "$real" 2>/dev/null || stat -f %Lp "$real" 2>/dev/null) && (( (8#$mode & 8#022) == 0 )); then
  extension_dir=$real
fi

# Write stdin to $1/$2 atomically: a fresh private temp file in the same directory renamed over the
# target. A target that is a symlink or not a regular file is refused rather than followed.
install_private_file() {
  local target=$1/$2 tmp
  [[ -L $target || ( -e $target && ! -f $target ) ]] && return 1
  tmp=$(umask 077; mktemp "$1/.$2.XXXXXX") || return 1
  if cat >"$tmp" && [[ ! -L $target ]] && mv -f "$tmp" "$target"; then
    return 0
  fi
  rm -f "$tmp"
  return 1
}

manifest_rewritten=false manifest_current=false
if [[ -n $daemon_origin && -n $extension_dir && -f $extension_dir/manifest.json && ! -L $extension_dir/manifest.json ]]; then
  # Rewritten only when it names another origin; the browser reads it again at its next start.
  if manifest=$(jq -c --arg pattern "$daemon_origin/*" '
    if .host_permissions == [$pattern] and .externally_connectable.matches == [$pattern] then empty
    else .host_permissions = [$pattern] | .externally_connectable.matches = [$pattern] end' "$extension_dir/manifest.json"); then
    if [[ -z $manifest ]]; then
      manifest_current=true
    elif printf '%s\n' "$manifest" | install_private_file "$extension_dir" manifest.json; then
      manifest_rewritten=true manifest_current=true
    fi
  fi
  [[ $manifest_current == true ]] || echo "openside-browser: could not point the extension at $daemon_origin" >&2
fi

# A browser already running on this profile keeps the manifest it started with, so a daemon that moved
# to another origin is one its extension will not pair with or take messages from. The origin a cold
# start loads is recorded in the profile; a live browser on this host (its SingletonLock names this
# host and a live pid) that loaded another one, or one started before this record existed while the
# manifest just changed, must be restarted.
browser_running() {
  local owner
  [[ -L $profile/SingletonLock ]] || return 1
  owner=$(readlink "$profile/SingletonLock") || return 1
  [[ ${owner%-*} == "$HOSTNAME" ]] && kill -0 "${owner##*-}" 2>/dev/null
}
loaded_origin=$profile/.openside-extension-origin
if [[ $manifest_current == true ]]; then
  if browser_running; then
    if [[ -f $loaded_origin && $(<"$loaded_origin") != "$daemon_origin" ]] || [[ ! -f $loaded_origin && $manifest_rewritten == true ]]; then
      rm -f "$handoff"
      rmdir "$handoff_dir" 2>/dev/null || true
      fail "the openside browser is still connected to the daemon's previous address; quit it and open it again"
    fi
  else
    printf '%s\n' "$daemon_origin" >"$loaded_origin"
  fi
fi

# The extension pairs itself from a one-time code (180 s, redeemable only from the extension's own
# origin) left beside its files: never in argv (jq reads it from stdin), never in a page, and not
# readable by pages (it is no web_accessible_resource). Redeeming it replaces the extension device of
# the previous launch.
launch_file= launch_content=
# Installing a code and removing an older launch's code take the same lock, so a cleanup that read its
# own code can never remove a newer launch's code that replaced it before the removal.
with_launch_lock() {
  local lock=$extension_dir/.launch-pairing.lock tries=0 status=0
  until mkdir "$lock" 2>/dev/null; do
    # Nobody holds it for more than a moment; a holder that died a minute ago is gone.
    find "$lock" -maxdepth 0 -type d -mmin +1 -exec rmdir {} \; 2>/dev/null || true
    (( ++tries > 200 )) && return 1
    sleep 0.05
  done
  "$@" || status=$?
  rmdir "$lock"
  return "$status"
}
if [[ -n $daemon_origin && -n $extension_dir ]] && jq -e '.extension_code | type == "string"' >/dev/null <<<"$access"; then
  launch_content=$(jq -c --arg url "$daemon_origin" '{url: $url, code: .extension_code}' <<<"$access")
  if printf '%s\n' "$launch_content" | with_launch_lock install_private_file "$extension_dir" launch-pairing.json; then
    launch_file=$extension_dir/launch-pairing.json
  else
    echo "openside-browser: could not hand the extension its pairing; pair it from its options page" >&2
  fi
elif [[ -n $daemon_origin && -e $extension ]] && jq -e '.extension_code | type == "string"' >/dev/null <<<"$access"; then
  echo "openside-browser: $extension is not a private directory; pair the extension from its options page" >&2
fi
# Another launch may have replaced the file meanwhile; only this launch's code is removed, and a
# symlink put in its place is never followed.
remove_own_launch_file() {
  [[ -f $launch_file && ! -L $launch_file ]] || return 0
  [[ $(cat "$launch_file" 2>/dev/null) == "$launch_content" ]] && rm -f "$launch_file"
  return 0
}
remove_launch_file() {
  [[ -n $launch_file ]] && with_launch_lock remove_own_launch_file
  return 0
}
trap 'rm -f "$handoff"; rmdir "$handoff_dir" 2>/dev/null || true; remove_launch_file' EXIT
open=file://$handoff
# Leave enough time for a cold launch to read the files, then remove the credential-bearing handoffs.
(sleep 30; rm -f "$handoff"; rmdir "$handoff_dir" 2>/dev/null || true; remove_launch_file) </dev/null >/dev/null 2>&1 &

# On Linux Chromium ignores --lang and takes its UI language from LANGUAGE (then LC_ALL, LC_MESSAGES,
# LANG); the UI language also seeds navigator.languages, which the web UI and extension follow while
# their Language setting is System. LANGUAGE counts only when it names one of the browser's own UI
# locales (locales/<name>.pak): `ko`, `pt-BR` and `zh-TW` work, while `ko_KR`, `pt` and `zh_Hant`
# silently fall back to the OS locale. So the configured tag is mapped onto a shipped locale: the
# tag itself, its bare language, en-US for English, else the first region the browser ships.
chromium_locale() {
  local tag=${1//_/-} base region locales candidate
  case ${tag,,} in
    zh-hant*) tag=zh-TW ;;
    zh-hans*) tag=zh-CN ;;
  esac
  base=${tag%%-*}
  if [[ $tag == *-* ]]; then
    region=${tag#*-}
    (( ${#region} == 2 )) && region=${region^^}
    tag=$base-$region
  fi
  locales=$(dirname "$(readlink -f "$browser")")/locales
  if [[ -d $locales ]]; then
    for candidate in "$tag" "$base" "$base-US" "$locales/$base"-*.pak; do
      candidate=${candidate##*/}
      candidate=${candidate%.pak}
      if [[ -e $locales/$candidate.pak ]]; then
        printf '%s\n' "$candidate"
        return
      fi
    done
  fi
  printf '%s\n' "$tag"
}
language=${OPENSIDE_BROWSER_LANG:-$(section_value browser language)}
if [[ -n $language ]]; then
  LANGUAGE=$(chromium_locale "$language")
  export LANGUAGE
fi
# A patched browser serves the person's own settings and native tools (Task manager, DevTools) to
# the daemon over a person-role gateway: never their tabs, and only for this profile's Default
# directory. It publishes in the directory the daemon names (the daemon looks nowhere else);
# stock Chromium ignores these switches.
gateway_args=()
person_runtime=$(jq -r '.person_browser_runtime_dir // empty' <<<"$access")
if [[ $person_runtime == /* ]] && (umask 077; mkdir -p "$person_runtime") 2>/dev/null && [[ -d $person_runtime && ! -L $person_runtime && -O $person_runtime ]] \
  && [[ $(stat -c %a "$person_runtime" 2>/dev/null || stat -f %Lp "$person_runtime" 2>/dev/null) == 700 ]]; then
  gateway_args=(
    --openside-gateway-instance-id="person-$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')"
    --openside-gateway-runtime-dir="$person_runtime"
    --openside-gateway-role=person
    --profile-directory=Default
  )
  # The daemon tells a stock browser (settings unsupported) from a closed one (not running) by
  # this record: exec keeps this pid for the browser. A launch that only hands a URL to an already
  # running browser leaves that browser's record alone.
  if ! browser_running; then
    patched=false
    LC_ALL=C grep -qaF openside-gateway-role "$(readlink -f "$browser")" 2>/dev/null && patched=true
    jq -nc --argjson pid "$$" --argjson patched "$patched" '{pid: $pid, patched: $patched}' \
      | install_private_file "$person_runtime" launch.json \
      || echo "openside-browser: could not record the browser launch for openside" >&2
  fi
else
  echo "openside-browser: the daemon named no private browser directory (${person_runtime:-none}); browser settings stay unavailable to openside" >&2
fi
exec "$browser" \
  --user-data-dir="$profile" \
  --class=openside \
  --no-first-run \
  --no-default-browser-check \
  --load-extension="$extension${theme:+,$theme}" \
  --openside-daemon-ui-url="$ui" \
  "${gateway_args[@]}" \
  "$open" "$@"
