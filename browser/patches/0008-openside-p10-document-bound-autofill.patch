+void PasswordAutofillAgent::ExtractFieldForOpenside(
+    FieldRendererId field_id,
+    ExtractFieldForOpensideCallback callback) {
+  auto* render_frame = unsafe_render_frame();
+  WebLocalFrame* frame = render_frame ? render_frame->GetWebFrame() : nullptr;
+  WebDocument document = frame ? frame->GetDocument() : WebDocument();
+  WebFormControlElement field = form_util::GetFormControlByRendererId(field_id);
+  if (!frame || frame->Parent() || !document || !field ||
+      field.GetDocument() != document ||
+      frame->DispatchedPagehideAndStillHidden()) {
+    std::move(callback).Run(std::nullopt, std::nullopt, url::Origin());
+    return;
+  }
+  const url::Origin origin = document.GetSecurityOrigin();
+  if (origin.opaque()) {
+    std::move(callback).Run(std::nullopt, std::nullopt, url::Origin());
+    return;
+  }
+  autofill_agent_->ExtractFormWithField(
+      field_id,
+      base::BindOnce(
+          [](ExtractFieldForOpensideCallback callback,
+             blink::DocumentToken token, url::Origin origin,
+             const std::optional<FormData>& form) {
+            std::move(callback).Run(form, token, origin);
+          },
+          std::move(callback), document.Token(), origin));
+}
+
+void PasswordAutofillAgent::FillFieldForOpenside(
+    FieldRendererId field_id,
+    const std::u16string& value,
+    const blink::DocumentToken& document_token,
+    const url::Origin& expected_origin,
+    FillFieldForOpensideCallback callback) {
+  auto* render_frame = unsafe_render_frame();
+  WebLocalFrame* frame = render_frame ? render_frame->GetWebFrame() : nullptr;
+  WebDocument document = frame ? frame->GetDocument() : WebDocument();
+  WebFormControlElement field = form_util::GetFormControlByRendererId(field_id);
+  const url::Origin actual_origin = document ? url::Origin(document.GetSecurityOrigin())
+                                              : url::Origin();
+  if (!frame || frame->Parent() || !document || !field ||
+      field.GetDocument() != document || document.Token() != document_token ||
+      expected_origin.opaque() || actual_origin != expected_origin ||
+      frame->DispatchedPagehideAndStillHidden()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  FillField(field_id, value, FieldPropertiesFlags::kAutofilledOnUserTrigger,
+            std::move(callback));
 }
 
