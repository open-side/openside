+
+// The one normalization a name goes through, whether typed or restored: a tab
+// title is one line, so pasted line breaks and runs of spaces collapse the way
+// the page title's own whitespace does in the tab strip; the cap counts
+// grapheme clusters so a cut never splits a surrogate pair, a combining
+// sequence or an emoji sequence; and the cut never leaves trailing whitespace.
+// Empty means "no name".
+std::u16string NormalizeCustomTitle(std::u16string_view title) {
+  std::u16string name =
+      base::CollapseWhitespace(title, /*trim_sequences_with_line_breaks=*/false);
+  size_t cut = name.size();
+  {
+    base::i18n::BreakIterator graphemes(
+        name, base::i18n::BreakIterator::BREAK_CHARACTER);
+    if (!graphemes.Init()) {
+      return std::u16string();
+    }
+    size_t count = 0;
+    while (graphemes.Advance()) {
+      if (++count == TabUIHelper::kMaxCustomTitleLength) {
+        cut = graphemes.pos();
+        break;
+      }
+    }
+  }
+  name.resize(cut);
+  base::TrimWhitespace(name, base::TRIM_TRAILING, &name);
+  return name;
+}
