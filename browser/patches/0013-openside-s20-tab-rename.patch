+void TabUIHelper::SetCustomTitle(std::u16string_view title) {
+  std::u16string name = NormalizeCustomTitle(title);
+  if (name.empty()) {
+    ClearCustomTitle();
+    return;
+  }
+  content::RenderFrameHost* frame = web_contents()->GetPrimaryMainFrame();
+  // The name belongs to the committed document's origin (its tuple, or its
+  // precursor's for an inherited about:blank or a sandboxed page). A tab with
+  // no tuple origin yet (a new blank tab, a restored tab that has not loaded)
+  // shows the name but does not save it, and its next commit clears it. An
+  // error page is named for the URL it failed to load, as
+  // DidFinishNavigation() compares it.
+  custom_title_origin_ = frame->IsErrorDocument()
+                             ? url::Origin::Create(frame->GetLastCommittedURL())
+                             : frame->GetLastCommittedOrigin();
+  if (custom_title_ == name) {
+    // Same name, but the origin it belongs to may have moved on.
+    PersistCustomTitle();
+    return;
+  }
+  custom_title_ = std::move(name);
+  PersistCustomTitle();
+  tab_ui_change_callbacks_.Notify();
+}
+
+void TabUIHelper::ClearCustomTitle() {
+  if (!custom_title_) {
+    return;
+  }
+  custom_title_.reset();
+  PersistCustomTitle();
+  tab_ui_change_callbacks_.Notify();
+}
+
+std::optional<std::string> TabUIHelper::GetCustomTitleSessionData() const {
+  // Only names on http and https sites are saved, the same rule restore
+  // applies; a name anywhere else (a file: or data: page, a new blank tab)
+  // still shows and follows the origin rules, it just does not come back.
+  const url::SchemeHostPort tuple =
+      custom_title_origin_.GetTupleOrPrecursorTupleIfOpaque();
+  if (!custom_title_ || !IsSavedCustomTitleOrigin(tuple)) {
+    return std::nullopt;
+  }
+  return tuple.Serialize() + "\n" + base::UTF16ToUTF8(*custom_title_);
+}
+
+// static
+void TabUIHelper::StashRestoredCustomTitle(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& extra_data,
+    const GURL& restored_url) {
+  auto it = extra_data.find(kCustomTitleSessionKey);
+  if (it == extra_data.end()) {
+    return;
+  }
+  // The session file is outside the browser's control: anything but exactly
+  // "<tuple origin>\n<one-line UTF-8 name>" restores no name.
+  const std::string_view value = it->second;
+  const size_t split = value.find('\n');
+  if (split == std::string_view::npos || split == 0) {
+    return;
+  }
+  const std::string_view origin_text = value.substr(0, split);
+  const std::string_view name_text = value.substr(split + 1);
+  if (name_text.empty() || name_text.find('\n') != std::string_view::npos ||
+      !base::IsStringUTF8(name_text)) {
+    return;
+  }
+  const GURL origin_url(origin_text);
+  if (!origin_url.is_valid() ||
+      !IsSavedCustomTitleOrigin(url::SchemeHostPort(origin_url))) {
+    return;
+  }
+  url::Origin origin = url::Origin::Create(origin_url);
+  if (origin.opaque() || origin.Serialize() != origin_text ||
+      !origin.IsSameOriginWith(restored_url)) {
+    return;
+  }
+  std::u16string name = NormalizeCustomTitle(base::UTF8ToUTF16(name_text));
+  if (name.empty()) {
+    return;
+  }
+  contents->SetUserData(&kRestoredCustomTitleKey,
+                        std::make_unique<RestoredCustomTitle>(
+                            std::move(origin), std::move(name)));
+}
+
+void TabUIHelper::PersistCustomTitle() {
+  content::WebContents* contents = web_contents();
+  if (!contents) {
+    return;
+  }
+  SessionService* service = SessionServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(contents->GetBrowserContext()));
+  if (!service) {
+    return;
+  }
+  const SessionID window_id =
+      sessions::SessionTabHelper::IdForWindowContainingTab(contents);
+  const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+  if (window_id.is_valid() && tab_id.is_valid()) {
+    service->AddTabExtraData(window_id, tab_id, kCustomTitleSessionKey,
+                             GetCustomTitleSessionData().value_or(""));
+  }
+}
